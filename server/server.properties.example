# Copy next to WitcherServer.jar as server.properties
# CLI port argument overrides this file; missing file uses UDP 40000.

port=40000
whitelist=false

# Optional shared secret (R5). When set, clients must send AUTH with the same token
# (config.xml <AuthToken>) before MOVE/UPDATE/etc are accepted.
# authToken=

# Optional HTTP status (SVG/JSON). Default status port is 40001.
svgEnabled=false
# svgPort=40001
# Bind defaults to loopback (R10). Use 0.0.0.0 only if intentionally public + firewalled.
svgBind=127.0.0.1
